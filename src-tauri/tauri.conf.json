{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Browser Monitor",
  "version": "0.1.0-5",
  "identifier": "local.josh.agentbrowsermonitor",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev -- --port 1420", "beforeBuildCommand": "npm run build" },
  "app": { "windows": [{ "title": "Agent Browser Monitor", "width": 1080, "height": 720, "minWidth": 660, "minHeight": 500, "decorations": false }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
