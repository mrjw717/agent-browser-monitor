  "identifier": "local.josh.agentbrowsermonitor",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev -- --port 1420", "beforeBuildCommand": "npm run build" },
